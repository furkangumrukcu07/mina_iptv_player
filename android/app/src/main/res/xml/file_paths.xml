<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider tarafından paylaşıma açılacak path'ler.

  external-files-path → getExternalFilesDir() altı:
    /storage/emulated/0/Android/data/com.mina.iptv.mina_iptv_player/files/...
    Kayıt (Recordings/) ve indirme (Downloads/) bu kök altında.

  external-cache-path → uygulama cache'i (gerekirse).
-->
<paths>
    <external-files-path name="external_files" path="." />
    <external-cache-path name="external_cache" path="." />
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
</paths>
