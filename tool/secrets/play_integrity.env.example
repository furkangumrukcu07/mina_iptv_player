# Mağaza / release derlemesinde Play Integrity decode için (git’e eklemeyin).
# Kurulum: bu dosyayı kopyalayıp gerçek anahtarı yazın:
#   cp tool/secrets/play_integrity.env.example tool/secrets/play_integrity.env
#
# android/app/build.gradle.kts bu dosyayı okur; flutter build / Android Studio
# ile AAB veya APK derlerken PLAY_INTEGRITY_API_KEY otomatik dart-define olur.
#
# Anahtar: Google Cloud Console → API'ler ve Hizmetler → Kimlik bilgileri
# → Play Integrity API etkin bir "API anahtarı".
PLAY_INTEGRITY_API_KEY=AIzaSy_REPLACE_WITH_YOUR_KEY

# İsteğe bağlı — boş bırakırsanız [IntegrityService.cloudProjectNumber] varsayılanı kullanılır.
# INTEGRITY_CLOUD_PROJECT_NUMBER=211496466896
