rules_version = '2';

// Mina IPTV Player — Firestore güvenlik kuralları.
//
// user_licenses: yalnızca Cloud Functions (Admin SDK) yazar.
// İstemci yalnızca kendi lisansını ve cihaz listesini okuyabilir.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isOwner(userId) || isAppAdmin();
      allow write: if isOwner(userId) && isValidBackup();

      match /{document=**} {
        allow read: if isOwner(userId) || isAppAdmin();
        allow write: if isOwner(userId);
      }
    }

    match /chats/rooms/{lang}/{messageId} {
      allow read: if isNonAnonymous();
      allow create: if isNonAnonymous() && isValidChatMessage();
      allow delete: if isNonAnonymous()
          && (resource.data.senderId == request.auth.uid || isChatAdmin());
      allow update: if false;
    }

    match /support_threads/{userId} {
      allow read: if (isOwner(userId) && isNonAnonymous()) || isChatAdmin();
      allow create, update: if (isOwner(userId) && isNonAnonymous()) || isChatAdmin();
      allow delete: if isChatAdmin();

      match /messages/{messageId} {
        allow read: if (isOwner(userId) && isNonAnonymous()) || isChatAdmin();
        allow create: if ((isOwner(userId) && isNonAnonymous()) || isChatAdmin())
            && isValidChatMessage();
        allow delete: if isNonAnonymous()
            && (resource.data.senderId == request.auth.uid || isChatAdmin());
        allow update: if false;
      }
    }

    // Presence: uygulamadaki tüm oturumlar (anonim deneme dahil) sayılabilir.
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && isValidPresence();
      allow delete: if isOwner(userId) || isChatAdmin();
    }

    // Premium lisans: istemci YAZAMAZ (yalnızca Cloud Functions / Admin SDK). Admin okuyabilir.
    match /user_licenses/{licenseId} {
      allow read: if request.auth != null && (
        isOwner(licenseId) ||
        (request.auth.token.email != null
            && licenseId == request.auth.token.email.lower())
        || isAppAdmin()
      );
      allow write: if isAppAdmin();

      match /devices/{deviceId} {
        allow read: if isOwner(licenseId);
        allow write: if false;
      }
    }

    // Trial Cihaz Takip Koleksiyonu
    match /device_trials/{deviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['trialStartMs', 'createdAt'])
                    && request.resource.data.trialStartMs is int;
      allow update: if false; // Deneme süresi başlangıcı sonradan değiştirilemez!
      allow delete: if false;
    }

    // Manual License Codes: Only Admin can read/write directly. Users redeem via Cloud Function.
    match /license_codes/{codeId} {
      allow read, write: if isAppAdmin();
    }


    // Global Announcements: Admin yazabilir, herkes okuyabilir.
    match /global_announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin();
    }
    
    // Admin Duyuruları
    match /admin_announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin();
    }

    // Admin Ayarları (Global ayarlar ve smart announcements vs.)
    match /admin_settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin();
    }

    // Admin İstatistikleri
    match /admin_stats/{statId} {
      allow read, write: if isAppAdmin();
    }

    // Global Overrides (Uzaktan Ayarlar)
    match /admin_settings/global_overrides {
      allow read: if request.auth != null;
      allow write: if isAppAdmin();
    }

    // Bildirim Geçmişi — yalnızca Admin SDK yazar, admin okur
    match /notification_history/{docId} {
      allow read: if isAppAdmin();
      allow write: if false;
    }

    // Zamanlanmış Bildirimler — yalnızca Admin SDK yazar, admin okur
    match /scheduled_notifications/{docId} {
      allow read: if isAppAdmin();
      allow write: if false;
    }

    // Uygulama Bannerları — herkes okur (banner gösterimi), admin yazar
    match /app_banners/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Admin İşlem Logları — yalnızca admin okur, Cloud Functions yazar
    match /admin_action_logs/{docId} {
      allow read: if isAppAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidChatMessage() {
  let d = request.resource.data;
  return d.senderId == request.auth.uid
      && d.messageText is string
      && d.messageText.size() > 0
      && d.messageText.size() <= 500
      && d.senderName is string
      && d.senderName.size() <= 120
      && d.keys().hasOnly(
          ['senderId', 'senderName', 'messageText', 'timestamp',
           'senderPhotoUrl', 'senderRole', 'replyToName', 'replyToText',
           'statusTag']);
}

function isValidPresence() {
  let d = request.resource.data;
  return d.keys().hasAll(['lastSeen'])
      && (!('name' in d) || (d.name is string && d.name.size() <= 120))
      && (!('email' in d) || d.email is string)
      && (!('photoUrl' in d) || d.photoUrl is string);
}

function isNonAnonymous() {
  return request.auth != null
      && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

function isChatAdmin() {
  return isNonAnonymous()
      && request.auth.uid in [
        'S90HID84FieYC4UBQ6BdoFrYtff2',
      ];
}

function isAppAdmin() {
  return isNonAnonymous()
      && (request.auth.uid == 'S90HID84FieYC4UBQ6BdoFrYtff2' || request.auth.token.email == 'furkangumrukcu07@gmail.com');
}

function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

function isValidBackup() {
  return !('data' in request.resource.data)
      || (request.resource.data.data is string
          && request.resource.data.data.size() < 2000000);
}
