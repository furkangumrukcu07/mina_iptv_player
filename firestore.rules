rules_version = '2';

// Mina IPTV Player — Firestore güvenlik kuralları.
//
// user_licenses: yalnızca Cloud Functions (Admin SDK) yazar.
// İstemci yalnızca kendi lisansını ve cihaz listesini okuyabilir.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidBackup();

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /chats/rooms/{lang}/{messageId} {
      allow read: if isNonAnonymous();
      allow create: if isNonAnonymous() && isValidChatMessage();
      allow delete: if isNonAnonymous()
          && (resource.data.senderId == request.auth.uid || isChatAdmin());
      allow update: if false;
    }

    match /support_threads/{userId} {
      allow read: if (isOwner(userId) && isNonAnonymous()) || isChatAdmin();
      allow create, update: if (isOwner(userId) && isNonAnonymous()) || isChatAdmin();
      allow delete: if isChatAdmin();

      match /messages/{messageId} {
        allow read: if (isOwner(userId) && isNonAnonymous()) || isChatAdmin();
        allow create: if ((isOwner(userId) && isNonAnonymous()) || isChatAdmin())
            && isValidChatMessage();
        allow delete: if isNonAnonymous()
            && (resource.data.senderId == request.auth.uid || isChatAdmin());
        allow update: if false;
      }
    }

    // Presence: uygulamadaki tüm oturumlar (anonim deneme dahil) sayılabilir.
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && isValidPresence();
      allow delete: if isOwner(userId) || isChatAdmin();
    }

    // Premium lisans: istemci YAZAMAZ (yalnızca Cloud Functions / Admin SDK).
    match /user_licenses/{licenseId} {
      allow read: if request.auth != null && (
        isOwner(licenseId) ||
        (request.auth.token.email != null
            && licenseId == request.auth.token.email.lower())
      );
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(licenseId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidChatMessage() {
  let d = request.resource.data;
  return d.senderId == request.auth.uid
      && d.messageText is string
      && d.messageText.size() > 0
      && d.messageText.size() <= 500
      && d.senderName is string
      && d.senderName.size() <= 120
      && d.keys().hasOnly(
          ['senderId', 'senderName', 'messageText', 'timestamp',
           'senderPhotoUrl', 'senderRole', 'replyToName', 'replyToText',
           'statusTag']);
}

function isValidPresence() {
  let d = request.resource.data;
  return d.keys().hasOnly(['lastSeen', 'name'])
      && (!('name' in d) || (d.name is string && d.name.size() <= 120));
}

function isNonAnonymous() {
  return request.auth != null
      && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

function isChatAdmin() {
  return isNonAnonymous()
      && request.auth.uid in [
        'S90HID84FieYC4UBQ6BdoFrYtff2',
      ];
}

function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

function isValidBackup() {
  return !('data' in request.resource.data)
      || (request.resource.data.data is string
          && request.resource.data.data.size() < 2000000);
}
